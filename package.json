{
  "name": "arachnid",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-only",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests vite.config.ts",
    "format": "prettier --write src tests manifests *.json *.ts *.js .github/workflows src-tauri/tauri.offline.conf.json src-tauri/tauri.offline.local.conf.json",
    "format:check": "prettier --check src tests manifests *.json *.ts *.js .github/workflows src-tauri/tauri.offline.conf.json src-tauri/tauri.offline.local.conf.json",
    "tauri": "tauri",
    "mods:inspect": "cargo run -p arachnid-mods --example offline --locked -- inspect src-tauri/resources/mods",
    "mods:verify": "cargo run -p arachnid-mods --example prepared --locked -- src-tauri/resources --release",
    "mods:verify-prepared": "cargo run -p arachnid-mods --example prepared --locked -- src-tauri/resources",
    "build:offline": "tauri build --config src-tauri/tauri.offline.conf.json",
    "build:offline:local": "tauri build --config src-tauri/tauri.offline.conf.json --config src-tauri/tauri.offline.local.conf.json",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-router": "4.6.4",
    "@lucide/vue": "1.70.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "eslint-config-prettier": "10.1.8"
  }
}
